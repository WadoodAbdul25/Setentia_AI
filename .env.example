# Development-only sidecar settings. Never commit real credentials.
SENTIA_HOST=127.0.0.1
SENTIA_PORT=43120
SENTIA_LOG_LEVEL=INFO
SENTIA_DATABASE_URL=sqlite+aiosqlite:///./.sentia/sentia.db

# Supplied at runtime by the extension. This placeholder is intentionally invalid.
SENTIA_TOKEN=replace-at-runtime

# The extension supplies API keys from VS Code SecretStorage; do not put one here.
SENTIA_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional. When omitted, Codex uses the model configured for the signed-in account.
# SENTIA_CODEX_MODEL=your-codex-model

# Deepgram credentials are also supplied by VS Code SecretStorage. Flux endpoint,
# model, and language hints are configured through the Sentia extension settings.

# OpenAI Voice can use VS Code SecretStorage. For this branch's local LiveKit
# pipeline, put credentials in the git-ignored apps/sidecar/.env instead:
# OPENAI_API_KEY=your-local-key
# CEREBRAS_API_KEY=your-local-key
# CEREBRAS_URL=https://api.cerebras.ai/v1
# SENTIA_CEREBRAS_MODEL=gpt-oss-120b
# Never commit that file or paste its contents into logs/chat.
