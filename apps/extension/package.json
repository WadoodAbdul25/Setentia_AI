{
  "name": "@sentia/extension",
  "displayName": "Sentia",
  "description": "Bring your codebase to life.",
  "version": "0.1.0",
  "private": true,
  "publisher": "sentia-local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "codebase",
    "voice",
    "claude"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:sentia.sidebar",
    "onCommand:sentia.open",
    "onCommand:sentia.connectAnthropic",
    "onCommand:sentia.disconnectAnthropic",
    "onCommand:sentia.restartSidecar",
    "onCommand:sentia.openDiagnostics"
  ],
  "main": "./dist/extension.js",
  "files": [
    "bin",
    "dist",
    "media",
    "package.json",
    "README.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sentia.open",
        "title": "Sentia: Open"
      },
      {
        "command": "sentia.restartSidecar",
        "title": "Sentia: Restart Local Sidecar"
      },
      {
        "command": "sentia.openDiagnostics",
        "title": "Sentia: Open Diagnostics"
      },
      {
        "command": "sentia.connectAnthropic",
        "title": "Sentia: Connect Anthropic"
      },
      {
        "command": "sentia.disconnectAnthropic",
        "title": "Sentia: Disconnect Anthropic"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sentia",
          "title": "Sentia",
          "icon": "media/sentia.svg"
        }
      ]
    },
    "views": {
      "sentia": [
        {
          "type": "webview",
          "id": "sentia.sidebar",
          "name": "Sentia"
        }
      ]
    },
    "configuration": {
      "title": "Sentia",
      "properties": {
        "sentia.development.sidecarExecutable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Development-only path to a Sentia sidecar executable. Leave empty in packaged builds."
        },
        "sentia.development.showLogsOnStartup": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Automatically show the Sentia output channel when running the extension in development mode, including npm start launches."
        },
        "sentia.development.logVoicePayloads": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Include spoken text chunks in development voice diagnostics. Leave disabled when repository answers may contain sensitive information."
        },
        "sentia.voice.deepgramModel": {
          "type": "string",
          "enum": [
            "flux-general-en",
            "flux-general-multi"
          ],
          "default": "flux-general-en",
          "description": "Deepgram Flux speech recognition model."
        },
        "sentia.voice.languageHints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Language hints used only with flux-general-multi, for example en and es."
        },
        "sentia.voice.deepgramEndpoint": {
          "type": "string",
          "default": "wss://api.deepgram.com",
          "scope": "machine",
          "description": "Deepgram WebSocket origin. Use wss://api.eu.deepgram.com, wss://api.au.deepgram.com, or a dedicated endpoint when required. Sentia always connects through /v2/listen."
        },
        "sentia.voice.deepgramTtsModel": {
          "type": "string",
          "default": "flux-bruce-en",
          "description": "Deepgram TTS voice model. Use a flux-* model for conversational context or an aura-2-* model when explicit speed control is required."
        },
        "sentia.voice.deepgramTtsSpeed": {
          "type": "number",
          "default": 1,
          "minimum": 0.7,
          "maximum": 1.5,
          "description": "Speaking-rate multiplier for Aura-2 TTS. Flux TTS ignores this setting because runtime speed control is not yet available."
        },
        "sentia.voice.openaiTranscriptionModel": {
          "type": "string",
          "enum": [
            "gpt-live-transcribe"
          ],
          "default": "gpt-live-transcribe",
          "description": "OpenAI model used for live voice transcription."
        },
        "sentia.voice.openaiRealtimeEndpoint": {
          "type": "string",
          "default": "wss://api.openai.com/v1/realtime?model=gpt-realtime",
          "scope": "machine",
          "description": "OpenAI Realtime WebSocket endpoint. Sentia uses the gpt-realtime session transport with gpt-live-transcribe for live input transcription."
        },
        "sentia.voice.openaiEndpoint": {
          "type": "string",
          "default": "https://api.openai.com",
          "scope": "machine",
          "description": "OpenAI HTTP origin used for speech generation."
        },
        "sentia.voice.openaiTtsModel": {
          "type": "string",
          "default": "gpt-4o-mini-tts",
          "description": "OpenAI text-to-speech model used for spoken answers."
        },
        "sentia.voice.openaiVoice": {
          "type": "string",
          "enum": [
            "alloy",
            "ash",
            "ballad",
            "coral",
            "echo",
            "fable",
            "nova",
            "onyx",
            "sage",
            "shimmer",
            "verse",
            "marin",
            "cedar"
          ],
          "default": "marin",
          "description": "Built-in OpenAI voice used for AI-generated speech."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build-native.mjs && node esbuild.mjs",
    "dev": "node scripts/build-native.mjs && node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@sentia/protocol": "workspace:*",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "vitest": "^4.1.11"
  }
}
